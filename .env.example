# Copy this file to .env and fill in what you need. Everything is optional.

# Port the server listens on
PORT=3000

# The public https address of this server (required for one-click logins and Instagram/Threads/TikTok media)
# PUBLIC_URL=https://social.yourcompany.com

# 64 hex chars used to encrypt account tokens. If empty, a key is generated in data/secret.key
# SECRET_KEY=

# Where the database and uploads are stored
# DATA_DIR=./data

# 0 = only the admin can create users (private company install); 1 = anyone can sign up (default)
# ALLOW_SIGNUP=1

# Max upload size in MB
# MAX_UPLOAD_MB=512

# One-click login apps. You can also paste these in the app under Server admin → Integrations.
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# THREADS_CLIENT_ID=
# THREADS_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORG_SCOPES=0
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=
# PINTEREST_SANDBOX=0
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
